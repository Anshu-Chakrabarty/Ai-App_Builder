# Required for AI generation (set this in Vercel → Project Settings → Environment Variables)
GEMINI_API_KEY=

# Optional — override Gemini model id
# GEMINI_MODEL=

# Optional — OpenRouter (default LLM when set; Gemini skipped unless LLM_GEMINI_FALLBACK=1)
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4o
# LLM_STRATEGY=openrouter
# LLM_GEMINI_FALLBACK=0
# both = race OpenRouter + Gemini
# openrouter = OpenRouter only (recommended)
# gemini = Gemini only

# Optional — higher GitHub API rate limits for live template catalogs
GITHUB_TOKEN=

# Optional — ThemeForest / Envato catalog
# Create at https://build.envato.com/create-token/
ENVATO_PERSONAL_TOKEN=
