# Required for AI generation (set this in Vercel → Project Settings → Environment Variables)
GEMINI_API_KEY=

# Optional — override Gemini model id
# GEMINI_MODEL=

# Optional — OpenRouter (races with Gemini when LLM_STRATEGY=both for lower latency / quota relief)
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4o
# OPENROUTER_SITE_URL=http://localhost:3000
# OPENROUTER_APP_NAME=AppBuilder AI
# LLM_STRATEGY=both
# both = race OpenRouter + Gemini (first success wins)
# openrouter = OpenRouter first, Gemini fallback
# gemini = Gemini only

# Optional — higher GitHub API rate limits for live template catalogs
GITHUB_TOKEN=

# Optional — ThemeForest / Envato catalog
# Create at https://build.envato.com/create-token/
ENVATO_PERSONAL_TOKEN=
